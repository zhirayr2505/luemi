# Server-side only. Never commit real credentials.
NODE_ENV=development
# Browser compile-time switches, NOT security controls. VITE_* values are public.
# Enable with approved, fully working V2 server sessions, private media and publication.
# Public VITE_ switches never enforce authentication.
VITE_LUEMI_REAL_ONLY=0
VITE_LUEMI_AUTH_V2=0
VITE_LUEMI_PRIVATE_DRAFT_UI=0
VITE_LUEMI_PRIVATE_MEDIA_UI=0
VITE_LUEMI_REAL_DISCOVERY_UI=0
VITE_LUEMI_REAL_MATCHES=0
VITE_LUEMI_GEO_PROVIDER_ENABLED=0
# Enables browser GPS button when server auth-gated limited local reverse is ready.
VITE_LUEMI_GEO_LOCAL_ENABLED=0
VITE_LUEMI_CONSENT_VERSION=
VITE_LUEMI_PRIVACY_POLICY_PATH=
VITE_LUEMI_REAL_CHATS=0
VITE_LUEMI_CHATS_DEMO=0
# OWNER PRODUCT DIRECTION: launch LUEMI to ALL verified eligible Telegram users.
# Never use invitation-only mode as production target (docs/PRODUCT_DIRECTION.md).
# These flags remain OFF in examples until real DB, consent and moderation are approved.
# Once safe, enable OPEN signups (not BETA invites) and use luemi-production namespace.
# Only server-verified Telegram initData can create a real account.
# Limited friends-only trial: genuine Telegram sessions + real private drafts ONLY.
# Requires active invite entries, explicit participant notice and no public media.
# This is NOT legal approval and NEVER turns on public registration.
REM06_FRIENDS_TEST_ENABLED=0
REM06_FRIENDS_TEST_NOTICE_ACCEPTED=0
VITE_LUEMI_FRIENDS_TEST_MODE=0
# V2 live screens reuse private registration; no AI provider, no public publishing.
VITE_LUEMI_REGISTRATION_V2=0
REM06_OPEN_SIGNUPS_ENABLED=0
REM06_OPEN_SIGNUPS_APPROVED=0
REM06_BETA_INVITES_ENABLED=0
REM06_BETA_INVITES_APPROVED=0
REM05B_SESSIONS_ENABLED=0
REM05B_BOT_NAMESPACE=
REM05B_AUTH_DATABASE_URL=
REM05B_REQUEST_DATABASE_URL=
REM05B_SESSION_PEPPER=
REM06_PRIVATE_DRAFT_ENABLED=0
REM06_PRIVACY_APPROVED=0
REM06_CONSENT_VERSION=
REM06_MEDIA_ENABLED=0
REM06_MEDIA_BUCKET=luemi-profile-private
REM06_MEDIA_WORKER_DATABASE_URL=
REM06_SUPABASE_PROJECT_REF=
REM06_SUPABASE_STORAGE_SECRET=
# OPERATOR-ONLY CLIs. Separate, least-privilege PostgreSQL logins; NOT the
# eight HTTP app roles and NEVER placed into public VITE_* variables.
# The current Supabase operator shells are NOLOGIN. Do not enable until
# a real review/deletion owner and least-privilege provisioning are approved.
REG01G_HUMAN_REVIEW_ENABLED=0
REG01G_HUMAN_REVIEW_POLICY_APPROVED=0
REG01G_MODERATOR_DATABASE_URL=
REG01G_MODERATOR_LABEL=
REM06_ERASURE_REQUEST_ENABLED=0
REM06_ERASURE_POLICY_APPROVED=0
REM06_ERASURE_REQUEST_DATABASE_URL=
REM06_ERASURE_WORKER_ENABLED=0
REM06_ERASURE_MAINTENANCE_APPROVED=0
REM06_ERASURE_WORKER_DATABASE_URL=
REG01H_SAFETY_OPERATOR_ENABLED=0
REG01H_SAFETY_POLICY_APPROVED=0
REG01H_SAFETY_OPERATOR_DATABASE_URL=
REG01H_OPERATOR_LABEL=
# Armenia is the target legal jurisdiction (docs/PRODUCT_DIRECTION.md),
# NOT a permission to enable live processing or transfer to foreign hosts.
# For launch review use docs/ARMENIA_LAUNCH_MASTER_GATE_2026-10-28.md.
REM06_PUBLICATION_ENABLED=0
REM06_MODERATION_OPERATIONAL_APPROVED=0
REM06_PUBLISHER_DATABASE_URL=
REM06_DISCOVERY_DATABASE_URL=
LUEMI_MATCHES_V1_ENABLED=0
LUEMI_MATCHES_POLICY_APPROVED=0
LUEMI_MATCHES_DATABASE_URL=
REM05C_ENABLED=0
REM05C_GEO_PROVIDER_ENABLED=0
# Keyless, server-only coarse reverse for the explicitly listed city centres.
# Requires REM05C_ENABLED=1 and REM05B_SESSIONS_ENABLED=1; no Geoapify costs.
REM05C_LOCAL_REVERSE_ENABLED=0
REM05C_BUDGET_DATABASE_URL=
REM05C_GLOBAL_DAILY_CAP=0
REM05C_VENDOR_DAILY_QUOTA=0
# Paid Geoapify requests are NEVER made unless enabled and budgeted.
GEOAPIFY_API_KEY=
# Chats V1 stays OFF until the integration checklist is approved.
LUEMI_CHATS_V1_ENABLED=0
LUEMI_CHATS_POLICY_APPROVED=0
LUEMI_CHATS_DATABASE_URL=
# Private chat media: dedicated, non-public Supabase Storage bucket; server-only credentials.
LUEMI_CHATS_MEDIA_ENABLED=0
LUEMI_CHATS_MEDIA_BUCKET=luemi-chat-private
# Reuses REM06_SUPABASE_PROJECT_REF and REM06_SUPABASE_STORAGE_SECRET on server.
# Development/test only. Production startup rejects this flag.
LUEMI_CHATS_LOCAL_MEDIA=0
PORT=3001
APP_ORIGIN=http://localhost:5173
TELEGRAM_BOT_TOKEN=
HEALTH_CHECK_KEY=
# Stage 01 does not connect to the database.
# DATABASE_URL=
