# Server-side only. Never commit real credentials.
NODE_ENV=development
# Browser compile-time switches, NOT security controls. VITE_* values are public.
# Enable with approved, fully working V2 server sessions, private media and publication.
# Public VITE_ switches never enforce authentication.
VITE_LUEMI_REAL_ONLY=0
# Public self-publish UX; only compiled in after server gates and privacy approval.
VITE_LUEMI_AUTOPUBLISH_PHOTOS=0
VITE_LUEMI_AUTH_V2=0
VITE_LUEMI_PRIVATE_DRAFT_UI=0
VITE_LUEMI_PRIVATE_MEDIA_UI=0
VITE_LUEMI_REAL_DISCOVERY_UI=0
VITE_LUEMI_REAL_MATCHES=0
VITE_LUEMI_GEO_PROVIDER_ENABLED=0
VITE_LUEMI_CONSENT_VERSION=
VITE_LUEMI_PRIVACY_POLICY_PATH=
VITE_LUEMI_REAL_CHATS=0
VITE_LUEMI_CHATS_DEMO=0
# Open signup is an explicit SERVER-side mode; existing beta invitation mode is
# mutually exclusive. Only verified Telegram initData can create a real account.
REM06_OPEN_SIGNUPS_ENABLED=0
REM06_OPEN_SIGNUPS_APPROVED=0
REM06_BETA_INVITES_ENABLED=0
REM06_BETA_INVITES_APPROVED=0
REM05B_SESSIONS_ENABLED=0
REM05B_BOT_NAMESPACE=
REM05B_AUTH_DATABASE_URL=
REM05B_REQUEST_DATABASE_URL=
REM05B_SESSION_PEPPER=
REM06_PRIVATE_DRAFT_ENABLED=0
REM06_PRIVACY_APPROVED=0
REM06_CONSENT_VERSION=
REM06_MEDIA_ENABLED=0
REM06_MEDIA_BUCKET=luemi-profile-private
REM06_MEDIA_WORKER_DATABASE_URL=
REM06_SUPABASE_PROJECT_REF=
REM06_SUPABASE_STORAGE_SECRET=
REM06_PUBLICATION_ENABLED=0
# Instant publish skips the human photo queue but NOT PNG re-encoding,
# Telegram authentication, age check, consent, private storage, CSRF or RLS.
REM06_AUTOPUBLISH_PHOTOS_ENABLED=0
REM06_AUTOPUBLISH_APPROVED=0
REM06_MODERATION_OPERATIONAL_APPROVED=0
REM06_ERASURE_REQUEST_ENABLED=0
REM06_ERASURE_POLICY_APPROVED=0
REM06_ERASURE_REQUEST_DATABASE_URL=
LUEMI_SUPPORT_TELEGRAM_CHAT_ID=
REM06_PUBLISHER_DATABASE_URL=
REM06_DISCOVERY_DATABASE_URL=
LUEMI_MATCHES_V1_ENABLED=0
LUEMI_MATCHES_POLICY_APPROVED=0
LUEMI_MATCHES_DATABASE_URL=
REM05C_ENABLED=0
REM05C_GEO_PROVIDER_ENABLED=0
REM05C_BUDGET_DATABASE_URL=
REM05C_GLOBAL_DAILY_CAP=0
REM05C_VENDOR_DAILY_QUOTA=0
# Paid Geoapify requests are NEVER made unless enabled and budgeted.
GEOAPIFY_API_KEY=
# Chats V1 stays OFF until the integration checklist is approved.
LUEMI_CHATS_V1_ENABLED=0
LUEMI_CHATS_POLICY_APPROVED=0
LUEMI_CHATS_DATABASE_URL=
# Private chat media: dedicated, non-public Supabase Storage bucket; server-only credentials.
LUEMI_CHATS_MEDIA_ENABLED=0
LUEMI_CHATS_MEDIA_BUCKET=luemi-chat-private
# Reuses REM06_SUPABASE_PROJECT_REF and REM06_SUPABASE_STORAGE_SECRET on server.
# Development/test only. Production startup rejects this flag.
LUEMI_CHATS_LOCAL_MEDIA=0
PORT=3001
APP_ORIGIN=http://localhost:5173
TELEGRAM_BOT_TOKEN=
HEALTH_CHECK_KEY=
# Stage 01 does not connect to the database.
# DATABASE_URL=
