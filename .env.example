# Server-side only. Never commit real credentials.
NODE_ENV=development
VITE_LUEMI_REAL_CHATS=0
VITE_LUEMI_CHATS_DEMO=0
# Chats V1 stays OFF until the integration checklist is approved.
LUEMI_CHATS_V1_ENABLED=0
LUEMI_CHATS_POLICY_APPROVED=0
LUEMI_CHATS_DATABASE_URL=
# Private chat media: dedicated, non-public Supabase Storage bucket; server-only credentials.
LUEMI_CHATS_MEDIA_ENABLED=0
LUEMI_CHATS_MEDIA_BUCKET=luemi-chat-private
# Reuses REM06_SUPABASE_PROJECT_REF and REM06_SUPABASE_STORAGE_SECRET on server.
# Development/test only. Production startup rejects this flag.
LUEMI_CHATS_LOCAL_MEDIA=0
PORT=3001
APP_ORIGIN=http://localhost:5173
TELEGRAM_BOT_TOKEN=
HEALTH_CHECK_KEY=
# Stage 01 does not connect to the database.
# DATABASE_URL=
